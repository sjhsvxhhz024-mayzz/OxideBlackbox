<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.EclipsBox" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/corona_gold</item>
        <item name="colorPrimaryVariant">@color/corona_amber</item>
        <item name="colorOnPrimary">@color/eclipse_black</item>
        <item name="colorSecondary">@color/indigo</item>
        <item name="colorSecondaryVariant">@color/indigo_dim</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="android:colorBackground">@color/eclipse_space</item>
        <item name="colorSurface">@color/panel_glass</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger</item>

        <item name="android:windowBackground">@color/eclipse_space</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/eclipse_space</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="materialCardViewStyle">@style/Widget.EclipsBox.Card</item>
    </style>

    <style name="Widget.EclipsBox.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/panel_glass</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/corona_gold</item>
    </style>

    <!-- Title text style using a clean geometric feel -->
    <style name="Text.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Dot">
        <item name="android:layout_width">9dp</item>
        <item name="android:layout_height">9dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/dot</item>
    </style>

    <!-- Splash: no action bar, eclipse background -->
    <style name="Theme.EclipsBox.Splash" parent="Theme.EclipsBox">
        <item name="android:windowBackground">@color/eclipse_space</item>
    </style>
</resources>
